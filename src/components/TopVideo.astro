---
import { SITE } from '../data/siteConfig';

interface Props {
  pageTitle: string;
  customSummary?: string;
}

const { pageTitle, customSummary } = Astro.props;

const defaultSummary = "This short video overview outlines the crucial security boundaries surrounding StripChat tokens. It explains why server-side token accounting cannot be bypassed with 'generators' or modified APKs, how legitimate promotional tokens actually reach accounts, and the immediate warning signs of online credential phishing campaigns.";
---

<section id="video-guide" class="top-video-section" aria-label="Educational Video Guide">
  <div class="top-video-grid">
    <div class="shorts-embed-wrap">
      <iframe
        src={SITE.youtubeEmbedUrl}
        title={`Video Guide: StripChat Free Tokens Safety and Verification (${pageTitle})`}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <div class="video-intro-content">
      <span class="video-meta-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        YouTube Shorts Guide &bull; Verified 2026
      </span>
      <h2>Watch: StripChat Free Tokens Safety Guide</h2>
      <p style="font-size: 1rem; color: #cbd5e1; margin-bottom: 0.85rem;">
        {customSummary || defaultSummary}
      </p>
      <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem; font-size: 0.88rem; color: var(--text-secondary);">
        <strong style="color: var(--text-primary);">Video Takeaways:</strong>
        <ul style="margin: 0.4rem 0 0 1rem; padding: 0;">
          <li>Legitimate token offers are marketing-funded or platform promotions, never offline hacks.</li>
          <li>Never install unverified Android APKs or provide passwords to claim promotional tokens.</li>
          <li>Server-side token balances make local memory injection or cheat scripts impossible.</li>
        </ul>
      </div>
      <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.65rem; margin-bottom: 0;">
        Video source: <a href={SITE.youtubeShortsUrl} target="_blank" rel="noopener noreferrer" style="color: #93c5fd;">Watch original on YouTube Shorts</a>. Embedded with privacy-enhanced mode.
      </p>
    </div>
  </div>
</section>
